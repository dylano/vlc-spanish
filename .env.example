# Copy to .env for local development. .env is gitignored — never commit real values.
# In production these are set in the Netlify UI:
#   Site configuration → Environment variables

# Anthropic API key, used only inside Netlify Functions (/api/enrich, /api/sentences).
# Never expose this to the browser: do not prefix it with VITE_.
ANTHROPIC_API_KEY=sk-ant-...

# Shared family passphrase gating the Claude-backed endpoints. This exists to
# protect the API bill, not the users. Entered once in Settings and sent as a
# header. Four words, e.g. two english and two spanish.
FAMILY_SECRET=four-random-words-go-here
