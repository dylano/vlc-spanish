{
  "name": "vlc-spanish",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "build": "node scripts/validate-dictionary.ts && node scripts/validate-frames.ts && tsc -b && vp build",
    "lint": "vp lint",
